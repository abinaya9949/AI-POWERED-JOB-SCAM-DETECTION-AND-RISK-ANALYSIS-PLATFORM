"""Multi-factor risk scoring engine (score 0-100) for JobShield AI."""
from urllib.parse import urlparse
 
from ml.predictor import predict
 
FREE_MAIL = {"gmail.com", "yahoo.com", "outlook.com", "hotmail.com",
"aol.com", "rediffmail.com", "proton.me"}
GUARANTEE = ["guaranteed income", "no interview", "guaranteed salary"]
URGENCY = ["urgent hiring", "apply immediately", "limited slots", "hurry"]
PAYMENT = ["registration fee", "processing fee", "security deposit",
"pay a fee", "training fee"]
ENTRY_LEVEL = {"", "none", "no experience", "fresher", "entry level"}
SALARY_CAP = {"USD": 120000, "INR": 2500000, "EUR": 100000}
 
 
def risk_level(score: int) -> str:
if score >= 75:
return "CRITICAL"
if score >= 50:
return "HIGH"
if score >= 25:
return "MODERATE"
return "LOW"
 
 
def _hits(text: str, terms: list) -> list:
return [t for t in terms if t in text]
 
 
def analyze_job(job: dict) -> dict:
text = f"{job['job_title']} {job['description']}".lower()
factors, checks = [], {}
 
# 1. NLP + Random Forest classifier
label, conf = predict(text)
if label == "Suspicious":
pts = round(conf * 42)
factors.append(dict(
text=f"The Random Forest model identified linguistic scam "
f"patterns with {conf * 100:.1f}% confidence.",
points=pts, type="Machine Learning", severity="HIGH"))
 
# 2. Deceptive claims, pressure tactics, payment requests
hit = _hits(text, GUARANTEE)
if hit:
factors.append(dict(
text="Posting advertises guaranteed income without standard "
"interviews (" + ", ".join(f"'{h}'" for h in hit) + ").",
points=14, type="Deceptive Claims", severity="MEDIUM"))
hit = _hits(text, URGENCY)
if hit:
factors.append(dict(
text="High-pressure hiring language detected ('" + hit[0] +
"') used to prompt hasty action.",
points=8, type="Pressure Tactic", severity="LOW"))
hit = _hits(text, PAYMENT)
if hit:
factors.append(dict(
text="Candidate is asked for an upfront payment ('" + hit[0] +
"').", points=25, type="Payment Request",
severity="HIGH"))
 
# 3. Recruiter e-mail verification
email = (job.get("recruiter_email") or "").strip().lower()
e_dom = email.split("@")[-1] if "@" in email else ""
c_dom = urlparse(job.get("website_url") or "").netloc.lower()
c_dom = c_dom.replace("www.", "")
checks["email"] = {"contact": email, "domain": "@" + e_dom,
"status": "Verified", "alignment": "Matched"}
if e_dom in FREE_MAIL:
checks["email"].update(status="Suspicious",
alignment="Domain Mismatch / Unmatched")
factors.append(dict(
text=f"Recruiter contact is hosted on free public email "
f"(@{e_dom}). Reputable corporate recruiters typically "
f"correspond through dedicated enterprise domains.",
points=20, type="Identity Verification", severity="HIGH"))
elif c_dom and e_dom and not e_dom.endswith(c_dom):
checks["email"].update(status="Suspicious",
alignment="Domain Mismatch / Unmatched")
factors.append(dict(
text="Recruiter email domain does not match the company "
"website domain.", points=20,
type="Identity Verification", severity="HIGH"))
 
# 4. Company website verification
if not c_dom:
checks["website"] = {"claimed_url": "None provided",
"status": "Unable to Verify"}
factors.append(dict(
text="No company website was provided with this job posting. "
"Unable to verify digital web presence.",
points=10, type="Company Verification", severity="MEDIUM"))
else:
secure = (job["website_url"].startswith("https://"))
checks["website"] = {"claimed_url": job["website_url"],
"status": "Verified" if secure else "Weak",
"transport_security": "HTTPS" if secure
else "Missing"}
if not secure:
factors.append(dict(
text="Company website does not use HTTPS transport "
"security.", points=6,
type="Company Verification", severity="LOW"))
 
# 5. Rule-based salary anomaly detection
exp = (job.get("experience") or "").strip().lower()
cap = SALARY_CAP.get(job.get("currency", "USD"), 120000)
top = job.get("salary_max") or 0
if exp in ENTRY_LEVEL and top > cap:
factors.append(dict(
text=f"Rule-based salary anomaly analysis: Unusually high "
f"salary ({job['currency']} {int(top):,}) advertised for "
f"entry-level or no-experience role.",
points=15, type="Salary Anomaly", severity="HIGH"))
checks["salary"] = {"status": "High Salary Risk"}
else:
checks["salary"] = {"status": "Within Expected Range"}
 
score = min(100, sum(f["points"] for f in factors))
return {
"ml_label": label,
"ml_confidence": round(conf, 3),
"risk_score": score,
"risk_level": risk_level(score),
"factors": factors,
"checks": checks,
"recommendations": recommendations(factors),
}
 
 
ADVICE = {
"Identity Verification": ("Verify Recruiter Identity", "HIGH",
"Cross-reference the recruiter on LinkedIn or contact the "
"organization through their official verified public channels."),
"Company Verification": ("Request Corporate Information", "MEDIUM",
"Ask the hiring manager for a verified headquarters address, "
"official web portal, and enterprise references."),
"Salary Anomaly": ("Benchmark Market Compensation", "MEDIUM",
"Verify realistic wage ranges for this job title and experience "
"level on trusted industry portals like Levels.fyi or Glassdoor."),
"Deceptive Claims": ("Be Skeptical of Guaranteed Offers", "HIGH",
"Legitimate jobs require structured screening and interviews. "
"Unsolicited instant job offers are almost always fraudulent."),
"Payment Request": ("Never Pay Upfront Fees", "HIGH",
"Genuine employers do not charge candidates for registration, "
"training or equipment."),
}
 
 
def recommendations(factors: list) -> list:
seen = {f["type"] for f in factors}
return [dict(title=t, priority=p, detail=d)
for k, (t, p, d) in ADVICE.items() if k in seen]
