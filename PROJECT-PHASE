"""Load the trained pipeline and classify job posting text."""
import re
from pathlib import Path
 
import joblib
import nltk
from nltk.corpus import stopwords
from nltk.stem import WordNetLemmatizer
 
MODEL_PATH = Path(__file__).parent / "artifacts" / "job_scam_rf.joblib"
for _pkg in ("stopwords", "wordnet"):
nltk.download(_pkg, quiet=True)
_STOP = set(stopwords.words("english"))
_LEMMA = WordNetLemmatizer()
_model = None
 
 
def clean_text(text: str) -> str:
"""Lower-case, tokenize, remove stop-words and lemmatize."""
text = (text or "").lower()
text = re.sub(r"https?://\S+", " ", text)
tokens = re.findall(r"[a-z]+", text)                 # tokenization
tokens = [_LEMMA.lemmatize(t) for t in tokens
if t not in _STOP and len(t) > 1]          # stop-words
return " ".join(tokens)
 
 
def load_model():
global _model
if _model is None:
_model = joblib.load(MODEL_PATH)
return _model
 
 
def predict(text: str):
"""Return (label, confidence) for a job posting."""
model = load_model()
proba = model.predict_proba([clean_text(text)])[0]
scam_p = float(proba[list(model.classes_).index(1)])
if scam_p >= 0.5:
return "Suspicious", scam_p
return "Genuine", 1.0 - scam_p
