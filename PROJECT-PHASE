"""Explainable AI: SHAP token contributions for a prediction."""
import numpy as np
import shap
 
from ml.predictor import load_model, clean_text
 
 
def top_tokens(text: str, k: int = 5):
model = load_model()
tfidf, rf = model.named_steps["tfidf"], model.named_steps["rf"]
X = tfidf.transform([clean_text(text)]).toarray()
sv = shap.TreeExplainer(rf).shap_values(X)
# SHAP output layout differs between library versions
vals = sv[1][0] if isinstance(sv, list) else sv[0, :, 1]
names = tfidf.get_feature_names_out()
idx = np.argsort(-np.abs(vals))[:k]
return [{"token": str(names[i]), "shap": round(float(vals[i]), 4)}
for i in idx]
