import { useState } from "react";
import { useNavigate } from "react-router-dom";
import api from "./api";
 
const PRESETS = [
{ label: "Safe Genuine Job: Senior Python Engineer (Stripe)",
job_title: "Senior Python Backend Engineer",
company_name: "Stripe, Inc.", experience: "5+ years",
description: "Build and maintain payment APIs. Interviews: 4 rounds.",
salary_min: 150000, salary_max: 190000, currency: "USD",
website_url: "https://stripe.com",
recruiter_email: "talent@stripe.com" },
{ label: "Critical Scam: Unrealistic Salary & Check Deposit",
job_title: "Executive Courier & Financial Assistant",
company_name: "Private Wealth Syndicate", experience: "None",
description: "Urgent hiring! Earn $5,000/week working 2 hours per "
+ "day from home. No interview required! Guaranteed income!",
salary_min: 180000, salary_max: 250000, currency: "USD",
website_url: "", recruiter_email: "kane.wealth.mgmt@yahoo.com" },
];
 
const EMPTY = {
job_title: "", company_name: "", description: "", location: "",
employment_type: "Full-time", experience: "", salary_min: "",
salary_max: "", currency: "USD", website_url: "",
recruiter_email: "", recruiter_name: "", source: "", posting_url: "",
};
 
export default function AnalyzePage() {
const [form, setForm] = useState(EMPTY);
const [loading, setLoading] = useState(false);
const navigate = useNavigate();
 
const update = (e) =>
setForm({ ...form, [e.target.name]: e.target.value });
 
const submit = async (e) => {
e.preventDefault();
setLoading(true);
try {
const payload = {
...form,
salary_min: form.salary_min ? Number(form.salary_min) : null,
salary_max: form.salary_max ? Number(form.salary_max) : null,
};
const { data } = await api.post("/api/analysis", payload);
navigate(`/result/${data.id}`);
} finally {
setLoading(false);
}
};
 
const Field = ({ name, label, required, ...rest }) => (
<div className="flex flex-col gap-1">
<label className="text-xs text-slate-400">
{label}{required && <span className="text-red-400"> *</span>}
</label>
<input name={name} value={form[name]} onChange={update}
required={required} {...rest}
className="rounded-lg border border-slate-700 bg-slate-900
px-3 py-2 text-sm text-white" />
</div>
);
 
return (
<form onSubmit={submit} className="mx-auto max-w-4xl p-6 space-y-6">
<h1 className="text-3xl font-bold text-white">
Analyze a Job Posting
</h1>
 
<section className="rounded-xl border border-slate-800 p-4">
<p className="mb-2 text-xs text-cyan-400">
PRE-CONFIGURED TEST SAMPLES
</p>
<div className="grid grid-cols-2 gap-3">
{PRESETS.map((p) => (
<button type="button" key={p.label}
onClick={() => setForm({ ...EMPTY, ...p })}
className="rounded-lg border border-slate-700 p-3
text-left text-xs text-slate-200">
{p.label} <span className="text-cyan-400">Load</span>
</button>
))}
</div>
</section>
 
<section className="grid grid-cols-2 gap-4">
<Field name="job_title" label="Job Title" required />
<Field name="company_name" label="Company Name" required />
<textarea name="description" value={form.description}
onChange={update} required rows={5}
placeholder="Full job description *"
className="col-span-2 rounded-lg border
border-slate-700 bg-slate-900 p-3
text-sm text-white" />
<Field name="location" label="Location" />
<Field name="experience" label="Experience Required" />
</section>
 
<section className="grid grid-cols-3 gap-4">
<Field name="salary_min" label="Minimum Salary" type="number" />
<Field name="salary_max" label="Maximum Salary" type="number" />
<Field name="currency" label="Currency" />
</section>
 
<section className="grid grid-cols-2 gap-4">
<Field name="website_url" label="Company Website URL" />
<Field name="recruiter_email" label="Recruiter Contact Email" />
<Field name="recruiter_name" label="Recruiter Name" />
<Field name="source" label="Job Portal / Source" />
</section>
 
<button disabled={loading}
className="rounded-xl bg-gradient-to-r from-cyan-500
to-blue-600 px-6 py-3 font-semibold text-white">
{loading ? "Analyzing..." : "Analyze Job Posting"}
</button>
</form>
);
}
