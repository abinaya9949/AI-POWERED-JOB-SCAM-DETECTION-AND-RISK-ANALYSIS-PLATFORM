"""Job analysis, history, dashboard and PDF report endpoints."""
from io import BytesIO
from typing import Optional
 
from fastapi import APIRouter, Depends, HTTPException, Response
from pydantic import BaseModel
from reportlab.lib.pagesizes import A4
from reportlab.pdfgen import canvas
from sqlalchemy import func
from sqlalchemy.orm import Session
 
from auth import get_current_user
from database import get_db, Analysis, User
from ml.explain import top_tokens
from risk_engine import analyze_job
 
router = APIRouter()
 
 
class JobIn(BaseModel):
job_title: str
company_name: str
description: str
location: str = ""
employment_type: str = "Full-time"
experience: str = ""
salary_min: Optional[float] = None
salary_max: Optional[float] = None
currency: str = "USD"
website_url: str = ""
recruiter_email: str = ""
recruiter_name: str = ""
source: str = ""
posting_url: str = ""
 
 
def _own(db: Session, user: User, analysis_id: int) -> Analysis:
row = db.get(Analysis, analysis_id)
if not row or (row.user_id != user.id and user.role != "admin"):
raise HTTPException(404, "Analysis not found")
return row
 
 
@router.post("/analysis")
def create_analysis(job: JobIn, db: Session = Depends(get_db),
user: User = Depends(get_current_user)):
data = job.model_dump()
result = analyze_job(data)
result["shap_tokens"] = top_tokens(job.description)
row = Analysis(user_id=user.id, **data,
ml_label=result["ml_label"],
ml_confidence=result["ml_confidence"],
risk_score=result["risk_score"],
risk_level=result["risk_level"], result=result)
db.add(row)
db.commit()
db.refresh(row)
return {"id": row.id, **result}
 
 
@router.get("/analysis")
def history(q: str = "", level: str = "", db: Session = Depends(get_db),
user: User = Depends(get_current_user)):
query = db.query(Analysis).filter(Analysis.user_id == user.id)
if q:
like = f"%{q}%"
query = query.filter(Analysis.job_title.ilike(like) |
Analysis.company_name.ilike(like))
if level:
query = query.filter(Analysis.risk_level == level.upper())
rows = query.order_by(Analysis.id.desc()).all()
return [dict(id=r.id, job_title=r.job_title, company=r.company_name,
prediction=r.ml_label, score=r.risk_score,
level=r.risk_level, date=r.created_at.isoformat())
for r in rows]
 
 
@router.get("/analysis/{analysis_id}")
def detail(analysis_id: int, db: Session = Depends(get_db),
user: User = Depends(get_current_user)):
row = _own(db, user, analysis_id)
return {"id": row.id, "job_title": row.job_title,
"company": row.company_name, **row.result}
 
 
@router.delete("/analysis/{analysis_id}")
def remove(analysis_id: int, db: Session = Depends(get_db),
user: User = Depends(get_current_user)):
db.delete(_own(db, user, analysis_id))
db.commit()
return {"deleted": analysis_id}
 
 
@router.get("/dashboard/summary")
def summary(db: Session = Depends(get_db),
user: User = Depends(get_current_user)):
base = db.query(Analysis).filter(Analysis.user_id == user.id)
tiers = dict(base.with_entities(Analysis.risk_level,
func.count()).group_by(
Analysis.risk_level).all())
return {"total": base.count(),
"critical": tiers.get("CRITICAL", 0),
"high": tiers.get("HIGH", 0),
"moderate": tiers.get("MODERATE", 0),
"low": tiers.get("LOW", 0),
"model_scams": base.filter(
Analysis.ml_label == "Suspicious").count()}
 
 
@router.get("/analysis/{analysis_id}/report")
def report(analysis_id: int, db: Session = Depends(get_db),
user: User = Depends(get_current_user)):
row = _own(db, user, analysis_id)
buf = BytesIO()
pdf = canvas.Canvas(buf, pagesize=A4)
y = 800
pdf.setFont("Helvetica-Bold", 18)
pdf.drawString(50, y, "JobShield AI - Risk Assessment Report")
pdf.setFont("Helvetica", 11)
for line in [f"Report ID: #{row.id}",
f"Job Title: {row.job_title}",
f"Company: {row.company_name}",
f"Risk: {row.risk_score}/100 ({row.risk_level})",
f"AI Prediction: {row.ml_label} "
f"({row.ml_confidence * 100:.1f}% conf.)"]:
y -= 22
pdf.drawString(50, y, line)
y -= 30
pdf.setFont("Helvetica-Bold", 13)
pdf.drawString(50, y, "Traceable Contributing Factors")
pdf.setFont("Helvetica", 10)
for f in row.result["factors"]:
y -= 18
pdf.drawString(50, y, f"+{f['points']} pts  [{f['severity']}]  "
f"{f['text'][:80]}")
pdf.save()
return Response(buf.getvalue(), media_type="application/pdf")
